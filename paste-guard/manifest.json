{
  "manifest_version": 3,
  "name": "Paste Guard",
  "version": "0.3.0",
  "description": "Locally replaces detected names and sensitive text before pasting into supported AI chats. No API keys required.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
