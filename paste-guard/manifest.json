{
  "manifest_version": 3,
  "name": "Paste Guard",
  "version": "0.2.0",
  "description": "Swaps secrets for fake labels before you paste them into an AI chat. Real values never leave your browser.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["config.js", "detector.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
