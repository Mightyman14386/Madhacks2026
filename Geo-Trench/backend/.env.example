DEMO_MODE=true
# Create real Windows Firewall rules. Only takes effect when the server also runs as Administrator;
# otherwise every firewall action is a dry run.
ENFORCE_FIREWALL=True
# Minutes before a geofence rule auto-expires. Decimals work (e.g. 0.5) for testing.
RULE_TTL_MINUTES=30
# Not implemented; RESET_CONNECTIONS_ON_GEOFENCE is used instead. Leave false.
KILL_ON_GEOFENCE=false
# When a region is geofenced (enforced mode), reset existing IPv4 TCP connections to the blocked IPs.
RESET_CONNECTIONS_ON_GEOFENCE=true
# How often the background sync checks TTL expiry, new IPs, and orphan rules (seconds).
GEOFENCE_SYNC_SECONDS=5
# Comma-separated hostnames whose IPs must never be blocked (e.g. your VPN or API hosts).
# The default gateway, DNS servers and DATABRICKS_HOST are always protected automatically.
NEVER_BLOCK_HOSTS=
# Maximum remote IPs in one firewall rule; extra IPs are skipped.
MAX_IPS_PER_RULE=500
FIREWALL_CHUNK_SIZE=1000
MAX_COUNTRY_RULES=50
# Databricks workspace host for the AI agent (hostname only is fine). Its IPs are never blocked.
DATABRICKS_HOST=
MAXMIND_CITY_PATH=data/GeoLite2-City.mmdb
MAXMIND_ASN_PATH=data/GeoLite2-ASN.mmdb
ORIGIN_LAT=43.0731
ORIGIN_LNG=-89.4012
ORIGIN_NAME=Madison, WI
RETENTION_DAYS=7

# Databricks unified authentication (backend only; never use VITE_ for secrets).
# Or configure an existing Databricks CLI profile instead of a token.
DATABRICKS_HOST=https://dbc-84f3eead-a719.cloud.databricks.com
# OAuth service principal: replace both placeholders and uncomment the secret.
DATABRICKS_CLIENT_ID=<service-principal-client-id>
# DATABRICKS_CLIENT_SECRET=<service-principal-secret>
# Alternative: remove the placeholder client ID and use a PAT or CLI profile.
# DATABRICKS_TOKEN=
# DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=f281300984d67642
DATABRICKS_REFRESH_SECONDS=30
DATABRICKS_MAX_ROWS=2000
DATABRICKS_QUERY_TIMEOUT=45
